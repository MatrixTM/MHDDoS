# MHDDoS Web Panel Configuration

# Host IP to bind the web panel (Default: 127.0.0.1)
WEB_HOST=127.0.0.1

# Port for the web panel (Default: 5000)
WEB_PORT=5000

# Password required to log in to the panel and receive a JWT token (leave empty to disable authentication)
WEB_PASSWORD=

# Secret key used by the server to sign and verify JWT tokens
# Generate a random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=key_change_me
