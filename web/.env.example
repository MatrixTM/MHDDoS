# MHDDoS Web Panel Configuration

# Host IP to bind the web panel (Default: 127.0.0.1)
WEB_HOST=127.0.0.1

# Port for the web panel (Default: 5000)
WEB_PORT=5000

# Optional password/token to secure the panel.
# Leave empty for no password protection.
WEB_PASSWORD=

# Optional JWT 
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me

